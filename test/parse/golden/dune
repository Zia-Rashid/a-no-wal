; Golden tests: each x.t runs through `anwl`, output compared with x.expected.
; The rules live in dune.inc, generated by test/golden/gen.exe; after adding a .t file,
; run `dune test` then `dune promote` (and review the new .expected files).

(include dune.inc)

(rule
 (deps (glob_files *.t))
 (action
  (with-stdout-to dune.inc.gen
   (run %{exe:../../golden/gen.exe} ../../..))))

(rule
 (alias runtest)
 (action (diff dune.inc dune.inc.gen)))
